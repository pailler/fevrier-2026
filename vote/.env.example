# Mettre ces clés dans le fichier .env à la RACINE du dépôt iahome.
# Démarrage : à la racine, exécutez
#   docker compose -f docker-compose.vote.yml up -d --build

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# URL publique utilisée dans les QR (local : http://localhost:7890 ; prod : https://vote.iahome.fr)
VOTE_PUBLIC_BASE_URL=http://localhost:7890
